"DA3Inference": {
"api_node": false,
"category": "image/geometry estimation",
"deprecated": false,
"description": "Run Depth Anything 3 on an image. In multi-view mode each image is treated as a separate view of the same scene.",
"dev_only": false,
"display_name": "Run Depth Anything 3",
"essentials_category": null,
"experimental": false,
"has_intermediate_output": false,
"input": {
"required": {
"da3_model": [
"DA3_MODEL",
{}
],
"image": [
"IMAGE",
{}
],
"mode": [
"COMFY_DYNAMICCOMBO_V3",
{
"options": [
{
"inputs": {
"required": {}
},
"key": "mono"
},
{
"inputs": {
"required": {
"pose_method": [
"COMBO",
{
"default": "cam_dec",
"multiselect": false,
"options": [
"cam_dec",
"ray_pose"
],
"tooltip": "How the camera field-of-view is estimated (for Small/Base models only).\n- cam_dec: learned from image features.\n- ray_pose: derived geometrically from the model's 3D ray output.\nAffects perspective correctness of the 3D output. Try both if results look distorted."
}
],
"ref_view_strategy": [
"COMBO",
{
"default": "saddle_balanced",
"multiselect": false,
"options": [
"saddle_balanced",
"saddle_sim_range",
"first",
"middle"
],
"tooltip": "Which view acts as the geometric anchor.\n- saddle_balanced: the view most 'average' across all others (best general choice).\n- saddle_sim_range: the view most visually distinct from the others.\n- first / middle: fixed positional picks."
}
]
}
},
"key": "multiview"
}
],
"tooltip": "mono: single view image (works with any model variant).\nmultiview: all images processed together for geometric consistency + camera pose (for Small/Base models only)."
}
],
"resize_method": [
"COMBO",
{
"default": "upper_bound_resize",
"multiselect": false,
"options": [
"upper_bound_resize",
"lower_bound_resize"
],
"tooltip": "upper_bound_resize: scale so the longest side = resolution (caps memory, default).\nlower_bound_resize: scale so the shortest side = resolution (preserves more detail on tall/wide images, uses more memory)."
}
],
"resolution": [
"INT",
{
"default": 504,
"max": 2520,
"min": 140,
"step": 14,
"tooltip": "Resolution the model runs at (longest side, multiple of 14).\nLower = faster / less VRAM.\nHigher = more detail.\nOutput is upsampled back to the original size."
}
]
}
},
"input_order": {
"required": [
"da3_model",
"image",
"resolution",
"resize_method",
"mode"
]
},
