"output": [
"DA3_GEOMETRY"
],
"output_is_list": [
false
],
"output_matchtypes": null,
"output_name": [
"da3_geometry"
],
"output_node": false,
"output_tooltips": [
"Dictionary of non-normalized tensors.\nAlways has the keys: depth, image, mode.\nOptional keys: sky (for Mono/Metric), confidence (for Small/Base), extrinsics + intrinsics (for multi-view)."
],
